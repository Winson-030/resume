# Canonical origin. Must match the origin the edge actually serves (the apex
# domain currently 308-redirects to www, so canonical/hreflang/sitemap must use
# the www origin).
NEXT_PUBLIC_SITE_URL=https://www.winson.dev

# Search Console / Bing Webmaster verification tokens. When set, the matching
# <meta> tag is emitted on every locale.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Overrides the IndexNow key file inside public/ (default is <key>.txt).
INDEXNOW_KEY_FILE=7d41c9f0e3a84b6fa1c2d5e0937b4f18.txt

# Optional: pin sitemap lastmod / JSON-LD dateModified. Defaults to the last git
# commit date, then to build time.
SITE_LAST_MODIFIED=
